{
  "name": "thisquiz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "wasm": "wasm-pack build rust/ --target web --profile release-wasm",
    "build": "pnpm wasm && pnpm lint && vite build",
    "preview": "vite preview",
    "lint": "oxlint src/",
    "fmt": "oxfmt --write src/ tests/ e2e/ public/sw.js *.ts *.json",
    "fmt:check": "oxfmt --check src/ tests/ e2e/ public/sw.js *.ts *.json",
    "test:e2e": "playwright test",
    "screenshots": "pnpm build && playwright test -c playwright.screenshots.config.ts && (command -v oxipng >/dev/null && oxipng -o max --strip safe public/og-image.png public/screenshot-desktop.png public/screenshot-mobile.png || echo 'oxipng not found: images left unoptimized')",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "gen": "cargo run --release -- gen",
    "check": "cargo run --release -- check",
    "test": "cargo test --release"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "preact": "^11.0.0",
    "preact-iso": "^2.12.2",
    "tinykeys": "^3.0.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "html-minifier-terser": "^7.2.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vite-plugin-wasm": "^3.6.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
